      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nume"
    },
    "assete": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::media-asset.media-asset",
      "mappedBy": "etichete"
    }
  }
}

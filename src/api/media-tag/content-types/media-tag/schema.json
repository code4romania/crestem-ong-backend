{
  "kind": "collectionType",
  "collectionName": "media_tags",
  "info": {
    "singularName": "media-tag",
    "pluralName": "media-tags",
    "displayName": "Media Tag",
    "description": "A label for grouping media library assets. Managed only through the FDSC media library screen."

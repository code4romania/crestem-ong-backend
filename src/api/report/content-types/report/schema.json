{
  "kind": "collectionType",
  "collectionName": "reports",
  "info": {
    "singularName": "report",
    "pluralName": "reports",
    "displayName": "Report",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "evaluations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::evaluation.evaluation",
      "mappedBy": "report"
    },
    "finished": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "finishedAt": {
      "type": "datetime",
      "required": false
    },
    "closedBy": {
      "type": "enumeration",
      "enum": [
        "manual",
        "auto"
      ],
      "required": false
    },
    "ong": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::ong.ong",
      "inversedBy": "reports"
    },
    "phases": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::phase.phase",
      "inversedBy": "reports"
    }
  }
}

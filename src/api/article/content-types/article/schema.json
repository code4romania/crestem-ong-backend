{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "A library article. Blocks are stored as JSON exactly as on `page`; the category is derived from `subcategorie.parinte` and never stored twice."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "titlu": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titlu",
      "required": true
    },
    "rezumat": {
      "type": "text"
    },
    "subcategorie": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::library-category.library-category",
      "inversedBy": "articole",
      "required": true
    },
    "autor": {
      "type": "string"
    },
    "etichete": {
      "type": "json",
      "default": []
    },
    "stare": {
      "type": "enumeration",
      "enum": ["schita", "publicat"],
      "default": "schita",
      "required": true
    },
    "dataPublicarii": {
      "type": "datetime"
    },
    "vizibilitate": {
      "type": "json",
      "default": ["public"]
    },
    "blocuri": {
      "type": "json",
      "default": []
    },
    "fisiere": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images", "videos", "files"]
    },
    "tip": {
      "type": "string"
    }
  }
}

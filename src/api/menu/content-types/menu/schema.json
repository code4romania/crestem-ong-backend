{
  "kind": "collectionType",
  "collectionName": "menus",
  "info": {
    "singularName": "menu",
    "pluralName": "menus",
    "displayName": "Menu",
    "description": "A navigation menu of the public site. Seeded once per location; the API exposes no create or delete."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "location": {
      "type": "enumeration",
      "enum": ["header", "footer"],
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "menu.item"
    }
  }
}
